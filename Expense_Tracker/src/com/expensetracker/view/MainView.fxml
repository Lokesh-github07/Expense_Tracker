<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.2-ea"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expensetracker.controller.MainController"
      spacing="10"
      prefWidth="1000"
      prefHeight="700"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Menu Bar -->
    <MenuBar>
        <Menu text="File">
            <MenuItem text="Export to CSV" onAction="#exportToCSV"/>
            <SeparatorMenuItem/>
            <MenuItem text="Exit" onAction="#exitApplication"/>
        </Menu>
        <Menu text="View">
            <MenuItem text="Show Analytics" onAction="#showAnalytics"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About" onAction="#showAbout"/>
        </Menu>
    </MenuBar>

    <!-- Control Panel -->
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 10 0;">
        <Button text="➕ Add Expense" onAction="#showExpenseForm"
                style="-fx-font-weight: bold; -fx-background-color: #4CAF50; -fx-text-fill: white;"
                prefWidth="120"/>
        <Button text="🔄 Refresh" onAction="#refreshExpenses"
                prefWidth="80"/>
        <Separator orientation="VERTICAL" prefHeight="30"/>
        <Label text="Filter by:" style="-fx-font-weight: bold;"/>
        <Label text="Month:"/>
        <ComboBox fx:id="monthCombo" promptText="Select Month" prefWidth="120"/>
        <Label text="Year:"/>
        <TextField fx:id="yearField" promptText="2024" prefWidth="80"/>
        <Button text="Apply Filter" onAction="#filterExpenses"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;"
                prefWidth="100"/>
    </HBox>

    <!-- Expenses Table -->
    <TableView fx:id="expenseTable" prefHeight="400"
               style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="120"/>
            <TableColumn fx:id="amountColumn" text="Amount ($)" prefWidth="100"
                         style="-fx-alignment: CENTER_RIGHT;"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="400"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Summary Section -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
        <Label fx:id="totalLabel" text="Total: $0.00"
               style="-fx-font-size: 16pt; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
        <Label fx:id="countLabel" text="0 Expenses"
               style="-fx-font-size: 12pt; -fx-text-fill: #666;"/>
    </HBox>

</VBox>
