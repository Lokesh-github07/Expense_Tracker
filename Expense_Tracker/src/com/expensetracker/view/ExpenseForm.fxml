<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx/17.0.2-ea" 
          xmlns:fx="http://javafx.com/fxml/1" 
          fx:controller="com.expensetracker.controller.ExpenseFormController" 
          hgap="10" vgap="15" 
          prefWidth="400" prefHeight="300"
          style="-fx-background-color: white; -fx-padding: 20;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Title -->
    <Label text="Add New Expense" GridPane.columnIndex="0" GridPane.rowIndex="0" 
           GridPane.columnSpan="2" style="-fx-font-size: 16pt; -fx-font-weight: bold;"/>
    
    <!-- Amount -->
    <Label text="Amount ($):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="amountField" GridPane.rowIndex="1" GridPane.columnIndex="1" 
               promptText="0.00" prefWidth="200"/>
    
    <!-- Description -->
    <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="descriptionField" GridPane.rowIndex="2" GridPane.columnIndex="1" 
               promptText="Optional description" prefWidth="200"/>
    
    <!-- Date -->
    <Label text="Date:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <DatePicker fx:id="datePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" 
                prefWidth="200"/>
    
    <!-- Category -->
    <Label text="Category:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <ComboBox fx:id="categoryCombo" GridPane.rowIndex="4" GridPane.columnIndex="1" 
              prefWidth="200"/>
    
    <!-- Buttons -->
    <HBox spacing="20" GridPane.rowIndex="5" GridPane.columnIndex="0" 
          GridPane.columnSpan="2" alignment="CENTER">
        <Button text="Save" onAction="#saveExpense" 
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;" 
                prefWidth="80"/>
        <Button text="Cancel" onAction="#cancel" 
                style="-fx-background-color: #f44336; -fx-text-fill: white;" 
                prefWidth="80"/>
    </HBox>
    
</GridPane>